# Uncomment to build and run a release other than the one the lock selects.
# Read by `tasks.py::_base_version`, which passes it to every compose command,
# so the tag it builds and the tag the stack runs cannot disagree.
#
# Left without a number on purpose: nothing in this repository declares the
# version. It is derived from the installed infrahub-testcontainers, and
# tests/unit/test_pins.py fails if any file states one. A literal here was a
# copy nothing updated, handed to every fresh clone by `cp .env.example .env`.
# INFRAHUB_BASE_VERSION=
INFRAHUB_ADDRESS=http://localhost:8000
INFRAHUB_API_TOKEN=06438eb2-8019-4776-878c-0941b1f1d1ec
